{
  "name": "terlio.js",
  "version": "1.2.0",
  "description": "Composable terminal UI for commands, streams, and interactive workflows",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrA1ex/terlio.git"
  },
  "homepage": "https://github.com/DrA1ex/terlio",
  "keywords": [
    "terminal",
    "tui",
    "terminal-ui",
    "terminal-ui-framework",
    "cli",
    "cli-framework",
    "interactive-cli",
    "node",
    "nodejs",
    "javascript",
    "esm",
    "ansi",
    "unicode",
    "wcwidth",
    "terminal-renderer",
    "command-palette",
    "text-ui",
    "dashboard",
    "developer-tools",
    "zero-dependency",
    "syntax-highlighting"
  ],
  "type": "module",
  "bin": {
    "terlio.js": "bin/terlio.js"
  },
  "scripts": {
    "start": "node examples/chat.js",
    "terlio.js": "node bin/terlio.js",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-coverage.js",
    "check": "node --check bin/terlio.js && node --check src/index.js && find src/lib examples scripts test -name \"*.js\" -print0 | xargs -0 -n1 node --check",
    "verify": "npm run check && npm test && npm run test:package",
    "test:package": "node scripts/verify-package.js",
    "pack:dry-run": "npm pack --dry-run",
    "release:check": "npm run verify && npm run test:coverage && npm run test:security:release && npm audit && npm publish --dry-run",
    "prepublishOnly": "npm run verify",
    "examples": "node examples/index.js",
    "example:editor": "node examples/editor-lab.js",
    "example:palette": "node examples/command-palette.js",
    "example:stream": "node examples/streaming-workbench.js",
    "example:long-text": "node examples/long-text.js",
    "example:components": "node examples/components-showcase.js",
    "example:kit": "node examples/interaction-kit.js",
    "example:keys": "node examples/keys.js",
    "example:blocks": "node examples/blocks.js",
    "demo:code-review": "node examples/code-review.js",
    "example:themes": "node examples/themes.js",
    "demo:chat": "node examples/chat.js",
    "demo:support-desk": "node examples/support-desk.js",
    "example:syntax": "node examples/syntax-highlighting.js",
    "test:interface": "node scripts/run-tests.js test/interface/interfaceSnapshots.test.js",
    "test:interface:audit": "node scripts/interface-testing/auditGoldens.js",
    "test:interface:update": "TERLIO_UPDATE_INTERFACE_GOLDENS=1 node scripts/interface-testing/updateGoldens.js",
    "test:interface:review": "node scripts/interface-testing/reviewGoldens.js",
    "test:security:contract": "node scripts/security-testing/runContract.js",
    "test:security:contract:strict": "node scripts/security-testing/runContract.js --strict",
    "test:security:release": "npm run test:security:contract:strict && npm run test:interface:audit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "main": "./src/lib/index.js",
  "exports": {
    ".": "./src/lib/index.js",
    "./examples": "./examples/index.js",
    "./examples/*": "./examples/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
